{
  "name": "Image to PDF",
  "short_name": "Image to PDF",
  "description": "Convert images to a PDF on your device. Nothing is uploaded.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#E7EAEE",
  "theme_color": "#1D4FD7",
